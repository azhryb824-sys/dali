{
  "name": "dali-desktop",
  "version": "0.2.5",
  "description": "تطبيق نظام دالي الإداري المتكامل",
  "author": "Dally Corporation",
  "private": true,
  "type": "module",
  "main": "main.mjs",
  "scripts": {
    "start": "electron .",
    "build:windows": "electron-builder --win nsis --x64",
    "build:mac": "electron-builder --mac dmg zip --x64 --arm64 --publish never",
    "build:dir": "electron-builder --dir"
  },
  "devDependencies": {
    "electron": "^38.0.0",
    "electron-builder": "^26.0.12"
  },
  "dependencies": {
    "electron-updater": "^6.6.2"
  },
  "build": {
    "appId": "sa.dally.desktop",
    "productName": "نظام دالي الإداري",
    "artifactName": "Dali-Desktop-Setup-${version}.${ext}",
    "asar": true,
    "publish": {
      "provider": "github",
      "owner": "azhryb824-sys",
      "repo": "dali",
      "releaseType": "release"
    },
    "files": [
      "main.mjs",
      "preload.mjs",
      "offline.html",
      "assets/**/*",
      "package.json"
    ],
    "win": {
      "icon": "assets/dali-icon.ico",
      "target": ["nsis"]
    },
    "mac": {
      "icon": "assets/dali-icon.png",
      "category": "public.app-category.business",
      "identity": null,
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "artifactName": "Dali-Mac-${version}-${arch}.${ext}",
      "target": [
        {
          "target": "dmg",
          "arch": ["x64", "arm64"]
        },
        {
          "target": "zip",
          "arch": ["x64", "arm64"]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "نظام دالي الإداري",
      "installerIcon": "assets/dali-icon.ico",
      "uninstallerIcon": "assets/dali-icon.ico"
    }
  }
}
