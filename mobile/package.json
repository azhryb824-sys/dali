{
  "name": "dali-mobile",
  "version": "1.0.3",
  "private": true,
  "type": "module",
  "description": "تطبيق نظام دالي الإداري لأجهزة Android وiOS",
  "scripts": {
    "check": "node --check scripts/verify-config.mjs && node scripts/verify-config.mjs && tsc --noEmit --skipLibCheck --moduleResolution bundler --module esnext --target es2022 capacitor.config.ts",
    "assets": "bash scripts/generate-assets.sh",
    "sync": "npm run check && npx cap sync",
    "add:android": "npx cap add android",
    "add:ios": "npx cap add ios",
    "build:android": "npm run sync && cd android && ./gradlew bundleRelease",
    "open:android": "npx cap open android",
    "open:ios": "npx cap open ios"
  },
  "dependencies": {
    "@capacitor/app": "^8.1.1",
    "@capacitor/camera": "^8.2.3",
    "@capacitor/core": "^8.5.0",
    "@capacitor/device": "^8.0.3",
    "@capacitor/filesystem": "^8.1.3",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/network": "^8.0.1",
    "@capacitor/push-notifications": "^8.1.2",
    "@capacitor/share": "^8.0.1",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.3"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/cli": "^8.5.0",
    "@capacitor/ios": "^8.5.0",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
